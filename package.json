{
  "name": "sugara",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "test:e2e": "bun run --filter @sugara/web test:e2e",
    "test:e2e:docker": "./scripts/run-e2e.sh",
    "lint": "turbo lint",
    "format": "turbo format",
    "check": "turbo check",
    "check-types": "turbo check-types",
    "db:generate": "bun run --filter @sugara/api db:generate",
    "db:migrate": "bun run --filter @sugara/api db:migrate",
    "db:studio": "bun run --filter @sugara/api db:studio",
    "db:seed": "bun run --filter @sugara/api db:seed",
    "db:seed-faqs": "bun run --filter @sugara/api db:seed-faqs",
    "db:seed-weather-areas": "bun run --filter @sugara/api db:seed-weather-areas",
    "db:ensure-faqs-table": "bun run --filter @sugara/api db:ensure-faqs-table",
    "db:seed-user": "bun run --filter @sugara/api db:seed-user",
    "db:cleanup-guests": "bun run --filter @sugara/api db:cleanup-guests",
    "db:cleanup-orphan-covers": "bun run --filter @sugara/api db:cleanup-orphan-covers",
    "postinstall": "command -v git >/dev/null 2>&1 && lefthook install || true"
  },
  "packageManager": "bun@1.3.2",
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "lefthook": "2.2.2",
    "turbo": "2.11.10"
  },
  "dependencies": {
    "@serwist/next": "9.5.13",
    "@supabase/supabase-js": "2.119.0",
    "better-auth": "1.7.18",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "hono": "4.13.17",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "nodemailer": "10.4.0",
    "postcss": "8.5.32",
    "vitest": "4.1.12"
  },
  "overrides": {
    "hono": "4.13.17",
    "undici": "8.12.3",
    "picomatch": "4.0.4",
    "postcss": "8.5.32",
    "tmp": "0.2.7",
    "rollup": "4.60.4",
    "defu": "6.1.7",
    "vite": "7.3.7",
    "uuid": "11.1.1",
    "esbuild": "0.28.2",
    "brace-expansion": "5.0.12",
    "qs": "6.16.2",
    "@hono/node-server": "2.1.5",
    "@ai-sdk/provider-utils": "4.0.38",
    "body-parser": "2.4.0",
    "ip-address": "10.7.5",
    "fast-uri": "3.1.9",
    "browserslist": "4.28.9",
    "proxy-addr": "2.0.8",
    "source-map-js": "1.2.2",
    "sharp": "0.35.5",
    "zod": "4.6.7",
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  }
}
