# Dependencies
node_modules/

# Build outputs
dist/
.next/
out/

# Next.js auto-generates next-env.d.ts and flips its referenced path between
# `next dev` and `next build`, causing constant churn. Next regenerates it on
# every build, so it does not need to be tracked.
apps/web/next-env.d.ts

# Turborepo
.turbo/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

