.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Testing
coverage/
test-results/
playwright-report/

# Serwist (auto-generated Service Worker)
apps/web/public/sw.js
apps/web/public/sw.js.map
apps/web/public/swe-worker-*.js

