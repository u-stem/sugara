{
  "name": "@sugara/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "copy-scalar": "bun run scripts/copy-scalar-assets.ts",
    "predev": "bun run copy-scalar",
    "dev": "next dev --turbopack",
    "prebuild": "bun run copy-scalar",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "biome lint app/ components/ lib/",
    "format": "biome format --write app/ components/ lib/",
    "check": "biome check --write app/ components/ lib/",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "check-i18n": "bun run scripts/check-i18n-symmetry.ts"
