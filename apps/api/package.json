{
  "name": "@sugara/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./lib/app-settings": "./src/lib/app-settings.ts",
    "./lib/error-reporter": "./src/lib/error-reporter.ts",
    "./lib/faqs": "./src/lib/faqs.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude 'src/__tests__/integration/**'",
    "test:coverage": "vitest run --coverage --exclude 'src/__tests__/integration/**'",
    "test:integration": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql://sugara:sugara@localhost:55322/sugara_test} vitest run --fileParallelism=false src/__tests__/integration/",
    "lint": "biome lint src/",
    "format": "biome format --write src/",
    "check": "biome check --write src/",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/db/seed.ts",
    "db:seed-user": "bun run src/db/seed-user.ts",
    "db:cleanup-guests": "bun run src/db/cleanup-guests.ts",
    "db:seed-faqs": "bun run src/db/seed-faqs.ts",
    "db:ensure-faqs-table": "bun run src/db/ensure-faqs-table.ts"
  },
  "dependencies": {
    "@sugara/shared": "workspace:*",
    "@supabase/supabase-js": "2.106.2",
    "@upstash/redis": "1.38.0",
    "@vercel/edge-config": "1.4.3",
    "better-auth": "1.6.11",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.23",
    "nodemailer": "8.0.9",
    "pino": "10.3.1",
    "postgres": "3.4.8",
    "web-push": "3.6.7",
    "zod": "4.4.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "@types/nodemailer": "8.0.0",
    "@types/web-push": "3.6.4",
    "@vitest/coverage-v8": "4.1.0",
    "drizzle-kit": "0.31.10",
    "typescript": "6.0.2",
    "vitest": "4.1.7"
  }
}
